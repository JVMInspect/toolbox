.gradle
**/build/
!src/**/build/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrappper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath
.idea/

# IntelliJ output
out/

# Local scratch sources: manual class loading experiments and one-off dumps.
# Kept on disk, out of the repo.
src/main/kotlin/land/src/toolbox/jvm/util/ManualClassLoader.kt
src/test/kotlin/manualClassLoad.kt
src/test/kotlin/TestClass123.kt
src/test/kotlin/futureclientdump.kt

# Debugging leftovers
.gdb_history
hs_err_pid*.log
replay_pid*.log

# Working artifacts: dumped classes, VM struct dumps, relocation tables
/*.class
/*.clazz
/dump/
/dump */
/dump.zip
/voil/
/voil.zip
/dumped-classes/
/structs.txt
/relocationInfo.dat
